# 复制为 .env 并填入你的密钥；不要将 .env 提交到 Git
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 火山引擎（豆包）SAUC 语音识别
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
# 鉴权二选一：新版控制台填 VOLC_API_KEY；老版控制台填 VOLC_APP_KEY + VOLC_ACCESS_KEY
VOLC_API_KEY=
VOLC_APP_KEY=
VOLC_ACCESS_KEY=

# 生产部署安全设置（APP_SECRET 请用高强度随机值）
APP_ENV=development
APP_RELEASE=0.1.0
APP_SECRET=
APP_SECRET_FILE=
APP_PUBLIC_ORIGIN=
APP_COOKIE_PATH=/
APP_DB_PATH=
ALLOWED_HOSTS=*
MESSAGE_DAILY_LIMIT=10
APP_TIMEZONE=Asia/Shanghai
ASR_MAX_SECONDS=120
ASR_DAILY_SECONDS_LIMIT=600
ATTACHMENT_PARSE_CONCURRENCY=2
ATTACHMENT_UPLOAD_ADMISSION=4
REPORT_RETENTION_DAYS=365
USAGE_RETENTION_DAYS=90
